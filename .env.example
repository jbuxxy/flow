# Copy this file to .env and fill in real values. See README.md for details.

# --- Database ---
# Used by `docker compose up` to set up the bundled Postgres container.
POSTGRES_PASSWORD=changeme
# Only needed if you're pointing at your own Postgres instead of the
# bundled one (docker-compose.yml sets this automatically otherwise).
DATABASE_URL=postgresql://flow:changeme@localhost:5432/flow?schema=public
# Only needed for local schema iteration (`prisma migrate dev`), not for
# `migrate deploy` or a normal build/run.
SHADOW_DATABASE_URL=postgresql://flow:changeme@localhost:5432/flow_shadow?schema=public

# --- Auth (next-auth) ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public URL the app is served at.
NEXTAUTH_URL=http://localhost:3000

# --- Application-level encryption (AES-256-GCM) for stored secrets ---
# Must be a 64-character hex string (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# --- Web Push (VAPID) ---
# Generate a keypair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI push services may use if your server is misbehaving.
# mailto: address or https: URL. Defaults to mailto:admin@example.com.
VAPID_SUBJECT=mailto:admin@example.com
