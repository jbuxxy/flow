# next-auth@5 beta optionally peer-depends on @simplewebauthn/browser@^9,
# from its own (unused here) experimental WebAuthn provider — we run
# @simplewebauthn's v13 API directly via custom routes instead (see
# src/lib/webauthn.ts), which next-auth doesn't know about. Without this,
# `npm ci`/`npm install` ERESOLVE-fails on that unmet optional peer even
# though nothing actually needs v9.
legacy-peer-deps=true
